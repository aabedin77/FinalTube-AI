+      logger.success(msg);
+      await writeGitHubSummary(`### ⏭ Skip Duplicate Upload\n\n${msg}\n\n- **Video ID**: \`${dupCheck.videoId}\`\n- **Published At**: \`${dupCheck.publishedAt}\``);
