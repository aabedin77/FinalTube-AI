+
+  // Initialize Agents
+  const strategyAgent = new ContentStrategyAgent(db, credentials);
+  const scriptWriterAgent = new ScriptWriterAgent(db, credentials);
+  const thumbnailDesignerAgent = new ThumbnailDesignerAgent(db, credentials);
